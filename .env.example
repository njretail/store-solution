# Supabase 프로젝트 생성 후 Project Settings > API에서 값을 복사해 .env.local 로 저장하세요.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ⚠️ 서버 전용 — 절대 브라우저에 노출되면 안 됨 (직원 계정 생성/삭제용, Settings > API의 "비밀 키")
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Vercel Cron 인증용 — 설정해두면 Vercel이 크론 호출 시 Authorization: Bearer <값> 헤더를 자동으로 붙인다.
# (winback, auto-order 크론이 사용) Vercel 프로젝트 환경변수에도 동일한 값을 등록해야 함.
CRON_SECRET=your-random-secret

# 쿠팡파트너스(Coupang Partners) Open API 자격증명 — partners.coupang.com 가입 후 API 설정에서 발급.
# 없어도 발주 기능 자체는 동작하지만(원본 쿠팡 URL 그대로 사용), 이 값이 있어야 수수료 추적 딥링크가 생성됨.
COUPANG_PARTNERS_ACCESS_KEY=your-coupang-partners-access-key
COUPANG_PARTNERS_SECRET_KEY=your-coupang-partners-secret-key
